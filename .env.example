# Copie para .env e ajuste. O .env não vai pro git.

POSTGRES_USER=shalon
POSTGRES_PASSWORD=shalon
POSTGRES_DB=shalon

SHALON_AMBIENTE=dev

# Em produção gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Em produção, deixar isto no valor de dev não derruba o serviço: o app sorteia
# um segredo no arranque e grita no log. Mas aí ele muda a cada reinício, e todo
# aparelho faz uma renovação de token a mais. Defina o seu.
SHALON_JWT_SEGREDO=dev-inseguro-troque-em-producao

# Senha do dono (usuário "Adriano"), usada pelo `python -m app.seed`.
#
# Vazia na primeira semeadura, o seed sorteia uma e a imprime UMA vez no log.
# Preenchida, ela é usada — e também troca a senha de uma conta que já existe,
# que é como se conserta uma senha vazada sem abrir o banco na mão. Trocar a
# senha não desloga ninguém: as sessões abertas continuam abertas, e quem corta
# acesso é a tela de sessões do dono.
SHALON_SENHA_DONO=

# Senha da conta de máquina do agente de impressão em PC.
#
# Vazia, a conta não é criada — e se já existir (ela nascia com PIN "0000" fixo)
# o seed a desativa. Só preencha se você roda o `agente/` numa térmica presa a
# um computador; no fluxo normal a comanda sai no celular do balcão, pelo RawBT.
SHALON_SENHA_AGENTE=
